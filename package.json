{
  "name": "fiefdom",
  "productName": "Fiefdom",
  "version": "0.1.0",
  "description": "A medieval habit ledger: keep your weekly contract, tend your daily duties, earn reputation.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Fiefdom",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check:game": "node scripts/check-game-rules.cjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.fiefdom.app",
    "productName": "Fiefdom",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Fiefdom",
      "artifactName": "Fiefdom-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
